<%- include("partials/head", { title }) %>
  <section class="page-intro">
    <p class="eyebrow">YOUR KITCHEN JOURNAL</p>
    <h1>My recipes<span class="brand-dot">.</span></h1>
    <p>All the dishes you've shared with the community.</p>
  </section>
  <% if (!recipes.length) { %>
    <div class="empty-state">
      <div class="empty-icon">♨</div>
      <h3>Your recipe book is empty.</h3>
      <p>Share your first creation with the community.</p><a class="button" href="/recipes/new">＋ Add a recipe</a>
    </div>
    <% } else { %>
      <div class="recipe-grid">
        <% recipes.forEach(recipe=> { %>
          <article class="recipe-card">
            <a class="card-image" href="/recipes/<%= recipe._id %>">
              <img src="<%= recipe.imageUrl || 'https://images.unsplash.com/photo-1547592180-85f173990554?w=900' %>"
                alt="<%= recipe.title %>">
              <span class="category-tag">
                <%= recipe.category %>
              </span>
            </a>
            <div class="card-content">
              <div class="card-meta"><span>YOUR RECIPE</span><span>◷ <%= recipe.prepTime %> MIN</span></div>
              <h3><a href="/recipes/<%= recipe._id %>">
                  <%= recipe.title %>
                </a></h3>
              <p>
                <%= recipe.description %>
              </p><a class="text-link" href="/recipes/<%= recipe._id %>">Manage recipe →</a>
            </div>
          </article>
          <% }) %>
      </div>
      <% } %>
        <%- include("partials/foot") %>